# Pryxor - environment variables
# Any secret referenced via `secret_ref` in a configs/executors/*.json file
# must be defined here.

# --- Secrets referenced by executors --------------------------------
# BANK_API_TOKEN=replace_me_with_a_real_token

# --- Optional overrides ---------------------------------------------
# PRYXOR_LOG_LEVEL=INFO
# PRYXOR_STATE_PATH=/data/pryxor_state.sqlite3
# PRYXOR_CONFIG_DIR=./configs

# Symmetric encryption key for hold payloads (Fernet, 32 bytes base64).
# Generate one with:
#   python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Required in production. If it changes, old holds become unreadable.
PRYXOR_ENCRYPTION_KEY=

# --- Notification webhooks & keys (fill in your own) ----------------
# SLACK_OPS_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
# TEAMS_COMPLIANCE_WEBHOOK=https://outlook.office.com/webhook/XXX
# SOC_TOKEN=sk_soc_xxx
# Admin key (generate with: make register-admin Name=admin_name)
# PRYXOR_ADMIN_KEY=pryxor_admin_admin_name_rs5VJQLN7....
