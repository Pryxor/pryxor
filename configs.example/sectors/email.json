{
  "type": "declarative",
  "description": "Demo policy used by QUICKSTART.md — approve internal, hold external.",
  "rules": [
    {
      "name": "allow-internal-emails",
      "when": {
        "tool": "send_email",
        "to_domain_in": ["company.local"]
      },
      "then": { "approve": true }
    },
    {
      "name": "hold-external-emails",
      "when": { "tool": "send_email" },
      "then": {
        "hold": "EXTERNAL_EMAIL",
        "message": "External recipient requires human approval."
      }
    }
  ]
}
